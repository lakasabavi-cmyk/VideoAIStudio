{
    "name": "video-ai-studio",
    "version": "0.1.0",
    "description": "Professional video editing and AI processing studio",
    "main": "dist/electron/main.cjs",
    "type": "module",
    "homepage": "./",
    "scripts": {
        "dev": "concurrently \"npm run vite\" \"npm run electron\"",
        "vite": "vite",
        "electron": "wait-on http://localhost:5173 && electron .",
        "build": "npm run build:app && npm run build:electron && npm run build:preload",
        "build:app": "vite build",
        "build:electron": "esbuild electron/main/main.ts --bundle --platform=node --target=node16 --format=cjs --external:electron --external:ffmpeg-static --external:ffprobe-static --outfile=dist/electron/main.cjs",
        "preview": "vite preview",
        "type-check": "tsc --noEmit",
        "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
        "build:preload": "esbuild electron/preload/index.ts --bundle --platform=node --target=node16 --format=cjs --external:electron --outfile=dist/preload/index.cjs"
    },
    "dependencies": {
        "ffmpeg-static": "^5.2.0",
        "ffprobe-static": "^3.1.0",
        "fluent-ffmpeg": "^2.1.3",
        "lucide-react": "^0.303.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "uuid": "^14.0.3",
        "zustand": "^4.4.1"
    },
    "devDependencies": {
        "@electron/remote": "^2.1.2",
        "@types/fluent-ffmpeg": "^2.1.4",
        "@types/node": "^20.10.6",
        "@types/react": "^18.2.46",
        "@types/react-dom": "^18.2.18",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.16",
        "concurrently": "^8.2.2",
        "electron": "^27.0.0",
        "electron-builder": "^24.6.4",
        "esbuild": "^0.19.11",
        "eslint": "^8.56.0",
        "postcss": "^8.4.32",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "vite": "^5.0.10",
        "wait-on": "^7.1.0"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "build": {
        "appId": "com.videoai.studio",
        "productName": "VideoAIStudio",
        "asarUnpack": [
            "node_modules/ffmpeg-static/**",
            "node_modules/ffprobe-static/**"
        ]
    }
}
